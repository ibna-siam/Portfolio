# Environment Configuration Template
# Portfolio CMS — Implementation Foundation

# -----------------------------------------------------------------------------
# Neon PostgreSQL Database Configuration (Server-Side Only)
# -----------------------------------------------------------------------------
# Primary pooled connection string for serverless queries via @neondatabase/serverless.
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://placeholder_user:placeholder_password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string (required only for Drizzle migrations / drizzle-kit).
# Format: postgresql://[user]:[password]@[neon-hostname-unpooled]/[database]?sslmode=require
DATABASE_URL_UNPOOLED="postgresql://placeholder_user:placeholder_password@ep-placeholder-direct.region.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Auth.js Authentication (Server-Side Only)
# -----------------------------------------------------------------------------
# 32-byte secret generated via `openssl rand -hex 32` for encrypting session JWTs.
AUTH_SECRET="generate-a-secure-32-byte-secret-using-openssl-rand-hex-32"
# Canonical URL of the application
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Cloudinary Media Storage (Phase 4)
# -----------------------------------------------------------------------------
# Public Cloud Name for client asset delivery and upload endpoints
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="placeholder-cloud-name"
# Server-side API key for signed upload operations
CLOUDINARY_API_KEY="placeholder-api-key"
# Server-side API secret (STRICTLY SERVER-ONLY - NEVER EXPOSE TO CLIENT)
CLOUDINARY_API_SECRET="placeholder-api-secret"

